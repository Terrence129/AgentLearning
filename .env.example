# ---------------------------------------------------------------------------
# AgentLab environment
# Copy this file to `.env` (never commit `.env`) and fill in the keys you have.
# `.env` is loaded by agentlab.config.Settings.from_env().
# ---------------------------------------------------------------------------

# Which provider to use by default: deepseek | openai | mock
DEFAULT_PROVIDER=deepseek

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
# Pick a current tool-calling model; check https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4.1-mini

# --- DeepSeek (OpenAI-compatible API) ------------------------------------
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Optional: Qwen / Moonshot / any OpenAI-compatible endpoint -----------
# COMPAT_NAME=qwen
# COMPAT_API_KEY=sk-...
# COMPAT_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# COMPAT_MODEL=qwen-plus

# --- AgentLab paths -------------------------------------------------------
AGENTLAB_DATA_DIR=./data
AGENTLAB_TRACE_DIR=./traces

# --- Safety / cost --------------------------------------------------------
# Hard ceiling for a single lab run, in USD. The BudgetGuard refuses to continue.
AGENTLAB_RUN_BUDGET_USD=0.50
# Set to 1 to let `pytest -m network` hit real providers.
AGENTLAB_ALLOW_NETWORK=0
