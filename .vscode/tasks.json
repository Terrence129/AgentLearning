{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AgentLab: setup",
      "type": "shell",
      "command": "./tasks.sh",
      "args": ["setup"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tasks.ps1", "setup"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "AgentLab: doctor",
      "type": "shell",
      "command": "./tasks.sh",
      "args": ["doctor"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tasks.ps1", "doctor"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "AgentLab: test (foundation)",
      "type": "shell",
      "command": "./tasks.sh",
      "args": ["test"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tasks.ps1", "test"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "AgentLab: labs (all week tests)",
      "type": "shell",
      "command": "./tasks.sh",
      "args": ["labs"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tasks.ps1", "labs"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "AgentLab: week N tests",
      "type": "shell",
      "command": "./tasks.sh",
      "args": ["week", "${input:week}"],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/tasks.ps1",
          "week",
          "${input:week}"
        ]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "AgentLab: chat (week 1 deliverable)",
      "type": "shell",
      "command": "./tasks.sh",
      "args": ["chat"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tasks.ps1", "chat"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true }
    },
    {
      "label": "AgentLab: check (what CI runs)",
      "type": "shell",
      "command": "./tasks.sh",
      "args": ["check"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tasks.ps1", "check"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "AgentLab: format (ruff)",
      "type": "shell",
      "command": "./tasks.sh",
      "args": ["fmt"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tasks.ps1", "fmt"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "week",
      "type": "promptString",
      "description": "Lab week number (1-9)",
      "default": "1"
    }
  ]
}
